generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WordLevel {
  EASY
  MEDIUM
  HARD
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wordProgress     WordProgress[]
  dictionSessions  DictionSession[]
  speakingSessions SpeakingSession[]
}

model VocabularyWord {
  id      String    @id @default(cuid())
  word    String    @unique
  meaning String    @db.Text
  example String    @db.Text
  level   WordLevel @default(EASY)

  createdAt DateTime @default(now())

  progress WordProgress[]
}

model WordProgress {
  id     String @id @default(cuid())
  userId String
  wordId String

  sentence  String    @db.Text
  learned   Boolean   @default(false)
  learnedAt DateTime?
  updatedAt DateTime  @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, learnedAt])
}

model DictionSession {
  id     String @id @default(cuid())
  userId String

  exerciseId      String
  exerciseTitle   String
  durationSeconds Int

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SpeakingSession {
  id     String @id @default(cuid())
  userId String

  topicId         String
  topicTitle      String
  durationSeconds Int
  goalSeconds     Int
  rating          Int
  note            String? @db.Text

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
